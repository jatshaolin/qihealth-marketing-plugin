*.plugin
*.zip

# Secrets — nunca commit
.env
.env.local
*.key
*.pem
secrets.json
credentials.json

# Node modules (si en algún momento se agregan scripts)
node_modules/

# Python (si se agregan scripts)
__pycache__/
*.pyc
venv/

# Otros
.cache/
.tmp/
